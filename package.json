{
  "name": "netrabox-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"@netrabox/*\" --parallel dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @netrabox/core db:generate",
    "db:migrate": "pnpm --filter @netrabox/core db:migrate",
    "db:seed": "pnpm --filter @netrabox/core db:seed",
    "keys:generate": "tsx scripts/generate-keypair.ts",
    "bench": "pnpm --filter @netrabox/bench bench",
    "build": "pnpm --filter \"@netrabox/*\" build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
